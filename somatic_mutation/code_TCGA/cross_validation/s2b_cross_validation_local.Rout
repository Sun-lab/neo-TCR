> logistic_reg <- function(y, x, T_cell_prop, l0){
+   l1  = glm(y ~ x + T_cell_prop, family = "binomial")
+   lrt = anova(l0, l1, test = "LRT")
+   pv1 = as.numeric(lrt$`Pr(>Chi)`[2])
+   pv1
+ }
> 
> res_i = foreach(i = 1:n_TCRs, .combine="rbind")  %dopar%  {
+   if(i %% 100 == 0){ cat(i, date(), "\n") }
+   y  = TCR_mat[i,]
+   l0 = glm(y ~ T_cell_prop, family = "binomial")
+   
+   date()
+   pvals <- sapply(1:n_muts, function(j) {
+     logistic_reg(y, mut_mat[j,], T_cell_prop=T_cell_prop, l0=l0)
+   })
+   date()
+   
+   df1 = data.frame(TCR = rep(rownames(TCR_mat)[i], n_muts), 
+                    mut = rownames(mut_mat), 
+                    pval_LRT = pvals)
+   df1 = df1[df1$pval_LRT <= 0.1, ]
+ }
> 
