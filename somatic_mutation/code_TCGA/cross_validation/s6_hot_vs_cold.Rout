+     r_a = fread(file.path(res_dir, f1)); r_b = fread(file.path(res_dir, gsub("alpha","beta",f1)))
+     r_a[, TCR := paste0("alpha_", TCR)]; r_b[, TCR := paste0("beta_", TCR)]
